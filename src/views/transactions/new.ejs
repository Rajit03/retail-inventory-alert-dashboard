<%- include('../partials/header', { title: 'Record Transaction' }) %>

<div class="page-header">
  <h1 class="page-title">Record Stock Transaction</h1>
  <a href="/transactions" class="btn btn-secondary">&larr; Back to Transactions</a>
</div>

<% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
  <div class="alert alert-danger">
    <strong>Please fix the following errors:</strong>
    <ul>
      <% errors.forEach(err => { %>
        <li><%= err %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="card">
  <div class="form-container">
    <form action="/transactions" method="POST">
      <div class="form-group">
        <label for="item_id" class="form-label">Item *</label>
        <select id="item_id" name="item_id" class="form-control" required>
          <option value="">-- Select an Item --</option>
          <% items.forEach(item => { %>
            <option 
              value="<%= item.id %>" 
              <%= (typeof transaction !== 'undefined' && (transaction.item_id == item.id || transaction.itemId == item.id)) ? 'selected' : '' %>
            >
              <%= item.name %> (Current Stock: <%= item.quantity %>)
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="type" class="form-label">Transaction Type *</label>
        <select id="type" name="type" class="form-control" required>
          <option value="">-- Select Type --</option>
          <option value="IN" <%= (typeof transaction !== 'undefined' && transaction.type === 'IN') ? 'selected' : '' %>>IN (Add stock)</option>
          <option value="OUT" <%= (typeof transaction !== 'undefined' && transaction.type === 'OUT') ? 'selected' : '' %>>OUT (Remove stock)</option>
          <option value="ADJUST" <%= (typeof transaction !== 'undefined' && transaction.type === 'ADJUST') ? 'selected' : '' %>>ADJUST (Set exact stock)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="quantity" class="form-label">Quantity *</label>
        <input 
          type="number" 
          id="quantity" 
          name="quantity" 
          class="form-control" 
          step="1" 
          min="0" 
          required 
          value="<%= typeof transaction !== 'undefined' && transaction.quantity !== undefined ? transaction.quantity : '' %>"
          placeholder="e.g. 5"
        >
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Submit Transaction</button>
        <a href="/transactions" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
