<%- include('../partials/header', { title: 'Edit Item' }) %>

<div class="page-header">
  <h1 class="page-title">Edit Item</h1>
  <a href="/items" class="btn btn-secondary">&larr; Back to Catalogue</a>
</div>

<% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
  <div class="alert alert-danger">
    <strong>Please fix the following errors:</strong>
    <ul>
      <% errors.forEach(err => { %>
        <li><%= err %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="card">
  <div class="form-container">
    <form action="/items/<%= item.id %>" method="POST">
      <div class="form-group">
        <label for="name" class="form-label">Item Name *</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          class="form-control" 
          maxlength="100"
          required 
          value="<%= item.name %>"
        >
      </div>

      <div class="form-group">
        <label for="category" class="form-label">Category *</label>
        <input 
          type="text" 
          id="category" 
          name="category" 
          class="form-control" 
          maxlength="50"
          required 
          value="<%= item.category %>"
        >
      </div>

      <div class="form-group">
        <label for="price" class="form-label">Price ($) *</label>
        <input 
          type="number" 
          id="price" 
          name="price" 
          class="form-control" 
          step="0.01" 
          min="0" 
          required 
          value="<%= item.price %>"
        >
      </div>

      <div class="form-group">
        <label for="quantity" class="form-label">Quantity *</label>
        <input 
          type="number" 
          id="quantity" 
          name="quantity" 
          class="form-control" 
          step="1" 
          min="0" 
          required 
          value="<%= item.quantity %>"
        >
      </div>

      <div class="form-group">
        <label for="reorder_threshold" class="form-label">Reorder Threshold *</label>
        <input 
          type="number" 
          id="reorder_threshold" 
          name="reorder_threshold" 
          class="form-control" 
          step="1" 
          min="0" 
          required 
          value="<%= item.reorder_threshold %>"
        >
      </div>

      <div class="form-group">
        <label for="order_status" class="form-label">Order Status</label>
        <select id="order_status" name="order_status" class="form-control">
          <option value="NONE" <%= (item.order_status === 'NONE' || !item.order_status) ? 'selected' : '' %>>NONE</option>
          <option value="ORDERED" <%= item.order_status === 'ORDERED' ? 'selected' : '' %>>ORDERED</option>
          <option value="RECEIVED" <%= item.order_status === 'RECEIVED' ? 'selected' : '' %>>RECEIVED</option>
        </select>
      </div>

      <div class="form-group">
        <label for="expected_date" class="form-label">Expected Date (Required if ORDERED, YYYY-MM-DD)</label>
        <input 
          type="date" 
          id="expected_date" 
          name="expected_date" 
          class="form-control" 
          value="<%= item.expected_date ? item.expected_date : '' %>"
          placeholder="YYYY-MM-DD"
        >
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Update Item</button>
        <a href="/items" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
