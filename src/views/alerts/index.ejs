<%- include('../partials/header', { title: 'Exception Alerts' }) %>

<div class="page-header">
  <h1 class="page-title">Exception Alerts</h1>
</div>

<% if (alerts && alerts.length > 0) { %>
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <% alerts.forEach(alert => { %>
      <div class="card" data-testid="alert-card" style="padding: 1.25rem; display: flex; align-items: center; justify-content: space-between; border-left: 5px solid <%= alert.type === 'OUT_OF_STOCK' ? '#ef4444' : (alert.type === 'LOW_STOCK' ? '#f59e0b' : '#3b82f6') %>;">
        <div>
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem;">
            <% if (alert.type === 'OUT_OF_STOCK') { %>
              <span class="badge" data-testid="alert-badge" style="background-color: #fee2e2; color: #b91c1c;">OUT OF STOCK</span>
            <% } else if (alert.type === 'LOW_STOCK') { %>
              <span class="badge" data-testid="alert-badge" style="background-color: #fef3c7; color: #b45309;">LOW STOCK</span>
            <% } else { %>
              <span class="badge" data-testid="alert-badge" style="background-color: #dbeafe; color: #1d4ed8;">DELAYED ORDER</span>
            <% } %>
            <strong data-testid="alert-item-name" style="font-size: 1rem;"><%= alert.item_name %></strong>
          </div>
          <p data-testid="alert-message" style="color: var(--text-muted); font-size: 0.875rem; margin: 0;"><%= alert.message %></p>
        </div>
        <div>
          <a href="/items/<%= alert.item_id %>/edit" class="btn btn-secondary btn-sm">Manage Item</a>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="card no-items-card">
    <p data-testid="no-alerts-message">No alerts</p>
    <p style="font-size: 0.875rem; color: var(--text-muted);">All inventory stock levels and replenishment orders are healthy.</p>
  </div>
<% } %>

<%- include('../partials/footer') %>
